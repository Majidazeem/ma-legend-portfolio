{
  "rules": {
    ".read": false,
    ".write": false,
    "site": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'REPLACE_WITH_FIREBASE_ADMIN_UID'"
    },
    "inquiries": {
      ".read": "auth != null && auth.uid === 'REPLACE_WITH_FIREBASE_ADMIN_UID'",
      "$inquiryId": {
        ".write": "!data.exists() && newData.hasChildren(['name', 'service', 'message', 'createdAt'])",
        ".validate": "newData.hasChildren(['name', 'service', 'message', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "service": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}